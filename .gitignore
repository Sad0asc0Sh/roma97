!assets/uploads/children/.htaccess
!assets/uploads/certificates/
!assets/uploads/certificates/index.html
!assets/uploads/certificates/.htaccess
!assets/uploads/gallery/
!assets/uploads/gallery/index.html
!assets/uploads/gallery/.htaccess

