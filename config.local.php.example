<?php
/**
 * ROMA — Environment-Specific Configuration Overrides
 *
 * Copy this file to `config.local.php` and adjust settings.
 * config.local.php is excluded from version control (.gitignore).
 *
 * ─── cPanel Shared Hosting Setup ────────────────────────────────────────────
 *
 * 1. Create a MySQL database in cPanel > MySQL Databases
 * 2. Create a database user and grant ALL PRIVILEGES
 * 3. Set the values below to match your cPanel credentials
 * 4. Upload all files via File Manager or FTP
 * 5. Visit https://yourdomain.com/setup.php to run the installer
 * 6. After installation, DELETE setup.php from the server
 */

// ─── Database Credentials ──────────────────────────────────────────────────
// On cPanel, the database name is usually prefixed: cpanel_username_dbname
define('DB_HOST', 'localhost');
define('DB_NAME', 'cpanel_user_rooma');
define('DB_USER', 'cpanel_user_rooma');
define('DB_PASS', 'your_strong_password');

// ─── Application URL ───────────────────────────────────────────────────────
// Full URL without trailing slash. Examples:
//   'https://yourdomain.com'        — root domain
//   'https://yourdomain.com/rooma'  — subdirectory deployment
define('SITE_URL', 'https://yourdomain.com');

// ─── Security Options ──────────────────────────────────────────────────────
// Force redirect HTTP → HTTPS. Requires a valid SSL certificate (free via
// cPanel > SSL/TLS or Let's Encrypt).
define('FORCE_HTTPS', true);

// Set to false in production. Only enable for debugging on the server.
define('DEVELOPMENT_MODE', false);

// ─── Timezone ──────────────────────────────────────────────────────────────
// Iranian Standard Time. Change if your daycare is in a different timezone.
// define('APP_TIMEZONE', 'Asia/Tehran');

// ─── Session Isolation (Recommended for Shared Hosting) ────────────────────
// On cPanel shared hosting, sessions are stored in a shared /tmp directory
// by default. Setting a private path prevents other sites on the same server
// from reading your session files.
//
// Create a directory OUTSIDE public_html, e.g.:
//   /home/your_cpanel_user/sessions
// Then set permissions to 700:
//   chmod 700 /home/your_cpanel_user/sessions
//
// define('SESSION_SAVE_PATH', '/home/your_cpanel_user/sessions');

// ─── Session Idle Timeout ──────────────────────────────────────────────────
// Seconds of inactivity before automatic logout. Default: 7200 (2 hours).
// define('SESSION_IDLE_TIMEOUT', 7200);
