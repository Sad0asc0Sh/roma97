# ROMA Daycare — Gallery Upload Directory Hardening
# Disable directory listing
Options -Indexes

# Prevent execution of any scripts or executable files
<FilesMatch "\.(php|php3|php4|php5|phtml|pl|py|jsp|asp|sh|cgi)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
